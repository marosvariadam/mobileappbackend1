{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "CoachingMobileAppDb"
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_ENV_VAR_OR_SECRET_MANAGER",
    "Issuer": "CoachingApp",
    "Audience": "CoachingAppUsers"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "MLSettings": {
    "ModelPath": "App_Data/ml/progress-model.zip",
    "ModelName": "progress",
    "RetrainIntervalHours": 168,
    "MinNewRowsToRetrain": 50,
    "DriftRmseThreshold": 0.15,
    "SyntheticAthleteCount": 2000
  }
}
